<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modal_escolha"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/espaco_grande">

    <ProgressBar
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/roxo_venus" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_medio"
        android:layout_weight="1"
        android:text="@string/carregando_perfil"
        android:textColor="@color/preto_texto"
        android:textSize="15sp" />
</LinearLayout>
