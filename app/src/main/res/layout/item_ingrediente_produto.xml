<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/espaco_pequeno"
    android:paddingBottom="@dimen/espaco_pequeno">

    <TextView
        android:id="@+id/textNomeIngrediente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/preto_texto"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Glicerina" />

    <TextView
        android:id="@+id/textInciIngrediente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/cinza_descricao"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="GLYCERIN"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/textDescricaoIngrediente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/cinza_descricao"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Função cosmética de emoliência/condicionamento da pele."
        tools:visibility="visible" />

</LinearLayout>
