<?xml version="1.0" encoding="utf-8"?>
<!-- Separador da aba Listas (TituloSecaoAdapter): o nome da secao e uma linha
     ate o fim, como "Listas fixas ————". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/meio_espaco_grade"
    android:layout_marginEnd="@dimen/meio_espaco_grade"
    android:layout_marginBottom="@dimen/espaco_pequeno"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/textTituloSecao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:textColor="@color/cinza_descricao"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Listas fixas" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/espaco_pequeno"
        android:layout_weight="1"
        android:background="@color/borda_lilas" />

</LinearLayout>
