<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/textEstrelasBarra"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:textColor="@color/texto_label"
        android:textSize="@dimen/texto_label"
        tools:text="5★" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/barraAvaliacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:max="100"
        app:indicatorColor="@color/rosa_scan_inicio"
        app:trackColor="@color/cinza_input"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp"
        tools:progress="60" />

    <TextView
        android:id="@+id/textQuantosBarra"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/cinza_descricao"
        android:textSize="@dimen/texto_label"
        tools:text="7" />

</LinearLayout>
