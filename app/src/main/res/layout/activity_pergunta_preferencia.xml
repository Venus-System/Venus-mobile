<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradiente_venus"
    tools:context=".view.PerguntaPreferenciaActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCardTopo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.27" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineFimIlustracao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.46" />

    <ImageButton
        android:id="@+id/btnVoltar"
        style="@style/BotaoVoltar"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/desc_voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textPergunta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_grande"
        android:layout_marginEnd="@dimen/espaco_secao"
        android:lineSpacingMultiplier="0.95"
        android:text="@string/pergunta_preferencia"
        android:textColor="@color/white"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnVoltar" />

    <View
        android:id="@+id/cardOpcoes"
        android:layout_width="346dp"
        android:layout_height="439dp"
        android:layout_marginStart="@dimen/espaco_medio"
        android:layout_marginEnd="@dimen/espaco_medio"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_opcoes"
        app:layout_constraintBottom_toTopOf="@+id/btnAvancar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guidelineCardTopo" />

    <ImageView
        android:id="@+id/imgPergunta"
        android:layout_width="563dp"
        android:layout_height="0dp"
        android:layout_marginBottom="25dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/perguntas"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineFimIlustracao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textPergunta"
        app:layout_constraintWidth_percent="0.8" />

    <TextView
        android:id="@+id/textAjudaCabelo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:gravity="center"
        android:padding="4dp"
        android:text="@string/pergunta_ajuda_cabelo"
        android:textColor="@color/preto_texto"
        android:textSize="@dimen/texto_corpo"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/cardOpcoes"
        app:layout_constraintEnd_toEndOf="@+id/cardOpcoes"
        app:layout_constraintStart_toStartOf="@+id/cardOpcoes" />

    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
        android:id="@+id/campoBusca"
        android:layout_width="0dp"
        android:layout_height="@dimen/altura_opcao"
        android:layout_marginStart="@dimen/espaco_grande"
        android:layout_marginTop="@dimen/espaco_grande"
        android:layout_marginEnd="@dimen/espaco_grande"
        android:background="@drawable/bg_busca"
        android:completionThreshold="1"
        android:drawableStart="@drawable/ic_lupa"
        android:drawablePadding="@dimen/espaco_pequeno"
        android:hint="@string/hint_buscar_preferencia"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="@dimen/espaco_medio"
        android:paddingEnd="@dimen/espaco_medio"
        android:textColor="@color/preto_texto"
        android:textColorHint="@color/cinza_hint"
        android:textSize="@dimen/texto_corpo"
        app:layout_constraintEnd_toEndOf="@+id/cardOpcoes"
        app:layout_constraintStart_toStartOf="@+id/cardOpcoes"
        app:layout_constraintTop_toBottomOf="@+id/guidelineFimIlustracao" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollOpcoes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/espaco_grande"
        android:layout_marginTop="@dimen/espaco_medio"
        android:layout_marginEnd="@dimen/espaco_grande"
        android:layout_marginBottom="@dimen/espaco_grande"
        app:layout_constraintBottom_toBottomOf="@+id/cardOpcoes"
        app:layout_constraintEnd_toEndOf="@+id/cardOpcoes"
        app:layout_constraintStart_toStartOf="@+id/cardOpcoes"
        app:layout_constraintTop_toBottomOf="@+id/campoBusca">

        <LinearLayout
            android:id="@+id/listaSelecionados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAvancar"
        android:layout_width="348dp"
        android:layout_height="57dp"
        android:layout_marginStart="@dimen/espaco_grande"
        android:layout_marginEnd="@dimen/espaco_grande"
        android:layout_marginBottom="@dimen/espaco_grande"
        android:background="@drawable/bg_botao_avancar"
        android:text="@string/acao_avancar"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/texto_botao"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
