<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".view.DetalheProdutoActivity">

    <ImageButton
        android:id="@+id/btnVoltar"
        android:layout_width="@dimen/area_toque_minima"
        android:layout_height="@dimen/area_toque_minima"
        android:layout_marginStart="12dp"
        android:layout_marginTop="@dimen/espaco_pequeno"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/desc_voltar"
        android:rotation="180"
        android:scaleType="center"
        android:src="@drawable/ic_chevron"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgProduto"
        android:layout_width="@dimen/avatar_lista"
        android:layout_height="@dimen/avatar_lista"
        android:layout_marginTop="@dimen/espaco_pequeno"
        android:background="@drawable/bg_foto_produto"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnVoltar"
        app:shapeAppearanceOverlay="@style/FotoProdutoArredondada"
        tools:src="@drawable/ic_launcher_foreground" />

    <TextView
        android:id="@+id/textNomeProduto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_grande"
        android:layout_marginTop="@dimen/espaco_medio"
        android:layout_marginEnd="@dimen/espaco_grande"
        android:textColor="@color/preto_texto"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgProduto"
        tools:text="CeraVe Loção Facial Hidratante Noite" />

    <TextView
        android:id="@+id/textCategoriaProduto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/roxo_marca"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@+id/textNomeProduto"
        app:layout_constraintStart_toStartOf="@+id/textNomeProduto"
        app:layout_constraintTop_toBottomOf="@+id/textNomeProduto"
        tools:text="Hidratante" />

    <TextView
        android:id="@+id/textNotaProduto"
        android:layout_width="@dimen/nota_circular_cabecalho"
        android:layout_height="@dimen/nota_circular_cabecalho"
        android:layout_marginStart="@dimen/espaco_grande"
        android:layout_marginTop="@dimen/espaco_pequeno"
        android:background="@drawable/bg_nota_circular"
        android:gravity="center"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textCategoriaProduto"
        tools:text="87" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/abasProduto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_medio"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textNotaProduto"
        app:tabIndicatorColor="@color/roxo_venus"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/roxo_venus"
        app:tabTextColor="@color/preto_texto" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/conteudoAvaliacao"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/espaco_grande"
        android:paddingTop="@dimen/espaco_medio"
        android:paddingEnd="@dimen/espaco_grande"
        android:paddingBottom="@dimen/espaco_secao"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/abasProduto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/produto_titulo_ingredientes"
                android:textColor="@color/preto_texto"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/carregandoIngredientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/espaco_medio"
                android:indeterminateTint="@color/roxo_venus" />

            <TextView
                android:id="@+id/textIngredientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/cinza_descricao"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Cyclopentasiloxane, Dicaprylyl Carbonate, Dimethiconol, Parfum, Tocopheryl Acetate."
                tools:visibility="visible" />

            <TextView
                android:id="@+id/textRelatarErro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_grande"
                android:background="@drawable/bg_aviso_amarelo"
                android:padding="@dimen/espaco_medio"
                android:text="@string/produto_relatar_erro"
                android:textColor="@color/amarelo_aviso_texto"
                android:textSize="12sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/conteudoMatch"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/espaco_grande"
        android:paddingTop="@dimen/espaco_secao"
        android:paddingEnd="@dimen/espaco_grande"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/abasProduto">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/bg_lista_vazia"
            android:gravity="center"
            android:padding="@dimen/espaco_grande"
            android:text="@string/produto_match_indisponivel"
            android:textColor="@color/cinza_descricao"
            android:textSize="@dimen/texto_corpo" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaAlternativas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/espaco_medio"
        android:layout_marginTop="@dimen/espaco_medio"
        android:layout_marginEnd="@dimen/espaco_medio"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/espaco_secao"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/abasProduto"
        tools:itemCount="4"
        tools:listitem="@layout/item_alternativa_produto"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/textSemAlternativas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_secao"
        android:layout_marginTop="@dimen/espaco_secao"
        android:layout_marginEnd="@dimen/espaco_secao"
        android:gravity="center"
        android:text="@string/produto_sem_alternativas"
        android:textColor="@color/cinza_descricao"
        android:textSize="@dimen/texto_corpo"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/abasProduto" />

</androidx.constraintlayout.widget.ConstraintLayout>
