<?xml version="1.0" encoding="utf-8"?>
<!-- Um ponto da aba Match: bolinha colorida, titulo curto e no maximo uma linha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/espaco_medio"
    android:paddingTop="@dimen/espaco_pequeno"
    android:paddingEnd="@dimen/espaco_medio"
    android:paddingBottom="@dimen/espaco_pequeno">

    <View
        android:id="@+id/pontoMatch"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_ponto_positivo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textPontoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/nota_boa_texto"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Ajuda na pele seca" />

        <TextView
            android:id="@+id/textPontoLinha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/cinza_descricao"
            android:textSize="12sp"
            tools:text="Graças a Glycerin e mais 4." />

    </LinearLayout>

</LinearLayout>
