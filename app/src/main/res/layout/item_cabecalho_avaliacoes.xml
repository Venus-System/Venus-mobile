<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/espaco_pequeno">

    <include layout="@layout/include_resumo_avaliacoes" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnEscreverAvaliacao"
        style="@style/BotaoGradiente"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/espaco_medio"
        android:text="@string/avaliacoes_escrever"
        android:textSize="@dimen/texto_campo" />

    <TextView
        android:id="@+id/textJaAvaliou"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_pequeno"
        android:gravity="center"
        android:text="@string/avaliacoes_ja_avaliou"
        android:textColor="@color/cinza_descricao"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
