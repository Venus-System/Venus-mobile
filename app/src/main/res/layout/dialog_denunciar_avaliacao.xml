<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/espaco_grande"
        android:paddingTop="@dimen/espaco_pequeno"
        android:paddingEnd="@dimen/espaco_grande">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/denuncia_pergunta"
            android:textColor="@color/texto_label"
            android:textSize="@dimen/texto_corpo" />

        <RadioGroup
            android:id="@+id/grupoMotivos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno">

            <RadioButton
                android:id="@+id/motivoOfensivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/roxo_venus"
                android:minHeight="@dimen/area_toque_minima"
                android:text="@string/denuncia_motivo_ofensivo" />

            <RadioButton
                android:id="@+id/motivoSpam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/roxo_venus"
                android:minHeight="@dimen/area_toque_minima"
                android:text="@string/denuncia_motivo_spam" />

            <RadioButton
                android:id="@+id/motivoFalso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/roxo_venus"
                android:minHeight="@dimen/area_toque_minima"
                android:text="@string/denuncia_motivo_falso" />

            <RadioButton
                android:id="@+id/motivoSexual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/roxo_venus"
                android:minHeight="@dimen/area_toque_minima"
                android:text="@string/denuncia_motivo_sexual" />

            <RadioButton
                android:id="@+id/motivoOutro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/roxo_venus"
                android:minHeight="@dimen/area_toque_minima"
                android:text="@string/denuncia_motivo_outro" />

        </RadioGroup>

        <TextView
            style="@style/LabelCampo"
            android:layout_marginTop="@dimen/espaco_medio"
            android:labelFor="@+id/editDetalhesDenuncia"
            android:text="@string/denuncia_label_detalhes"
            android:textColor="@color/roxo_secao"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editDetalhesDenuncia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_borda"
            android:gravity="top|start"
            android:hint="@string/denuncia_hint_detalhes"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="@integer/limite_denuncia"
            android:minLines="3"
            android:padding="12dp"
            android:textColor="@color/preto_texto"
            android:textColorHint="@color/cinza_hint"
            android:textSize="@dimen/texto_corpo" />

        <TextView
            android:id="@+id/textErroDenuncia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/nota_ruim_texto"
            android:textSize="@dimen/texto_label"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
