<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradiente_venus"
    tools:context=".view.MenuActivity">

    <TextView
        android:id="@+id/textMenuTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_provisorio"
        android:textColor="@color/white"
        android:textSize="@dimen/texto_titulo_destaque"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textUsuario"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/textUsuario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_secao"
        android:layout_marginTop="@dimen/espaco_medio"
        android:layout_marginEnd="@dimen/espaco_secao"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="@dimen/texto_corpo"
        app:layout_constraintBottom_toTopOf="@+id/btnSair"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textMenuTitulo"
        app:layout_constraintWidth_max="@dimen/largura_max_conteudo" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSair"
        style="@style/BotaoGradiente"
        android:layout_marginStart="@dimen/espaco_secao"
        android:layout_marginTop="@dimen/espaco_secao"
        android:layout_marginEnd="@dimen/espaco_secao"
        android:text="@string/acao_sair"
        app:layout_constraintBottom_toTopOf="@+id/btnRefazerQuestionario"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textUsuario"
        app:layout_constraintWidth_max="@dimen/largura_max_conteudo" />

    <Button
        android:id="@+id/btnRefazerQuestionario"
        style="@style/BotaoContorno"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/espaco_secao"
        android:layout_marginTop="@dimen/espaco_medio"
        android:layout_marginEnd="@dimen/espaco_secao"
        android:text="@string/acao_refazer_questionario"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnSair"
        app:layout_constraintWidth_max="@dimen/largura_max_conteudo" />

</androidx.constraintlayout.widget.ConstraintLayout>
