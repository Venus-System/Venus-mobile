<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espaco_medio"
    android:background="@drawable/bg_card_lista">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgCapa"
        android:layout_width="0dp"
        android:layout_height="@dimen/altura_capa_lista"
        android:background="@color/lilas_claro"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CapaListaTopo"
        tools:src="@drawable/ic_launcher_foreground" />

    <TextView
        android:id="@+id/textNomeLista"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_medio"
        android:layout_marginEnd="@dimen/espaco_medio"
        android:maxLines="1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/preto_texto"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgCapa"
        tools:text="Produtos favoritados" />

</androidx.constraintlayout.widget.ConstraintLayout>
