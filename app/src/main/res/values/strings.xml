    <string name="sheet_couro_titulo">Como é o seu couro cabeludo?</string>
    <string name="sheet_couro_descricao">Olhe para a raiz, não para o comprimento do fio. O jeito mais fácil é lembrar como ele fica no segundo dia depois de lavar.</string>
    <string name="sheet_couro_desc_normal">Confortável. Sem coceira, sem oleosidade demais e sem descamação.</string>
    <string name="sheet_couro_desc_seco">Repuxa e pode coçar. Raiz áspera, sem brilho, com fios quebradiços.</string>
    <string name="sheet_couro_desc_sensivel">Arde, coça ou fica vermelho fácil, mesmo com shampoo comum.</string>
    <string name="sheet_couro_desc_oleoso">Fica pesado e brilhoso em um dia. A raiz gruda mesmo lavando sempre.</string>
    <string name="sheet_couro_desc_caspa">Descamação visível, em flocos brancos ou amarelados, com coceira.</string>

    <string name="sheet_pele_titulo">Qual é o seu tipo de pele?</string>
    <string name="sheet_pele_descricao">Pense em como a sua pele fica algumas horas depois da limpeza, sem nenhum produto. É esse estado natural que define o tipo.</string>
    <string name="sheet_pele_desc_normal">Equilibrada. Sem brilho e sem repuxo.</string>
    <string name="sheet_pele_desc_seca">Repuxa, descama e pede hidratação.</string>
    <string name="sheet_pele_desc_misto">Zona T oleosa, bochechas normais.</string>
    <string name="sheet_pele_desc_oleoso">Brilho o dia todo e poros abertos.</string>
    <string name="sheet_pele_desc_sensivel">Reage fácil, com ardência ou vermelhidão.</string>

    <string name="sheet_fototipo_titulo">Qual é o seu fototipo de pele?</string>
    <string name="sheet_fototipo_descricao">O fototipo descreve como a sua pele reage ao sol, e não a cor dela. Pense no que acontece depois de meia hora de sol forte, sem protetor.</string>
    <string name="sheet_fototipo_desc_1">Sempre queima, nunca bronzeia</string>
    <string name="sheet_fototipo_desc_2">Quase sempre queima, bronzeia pouco</string>
    <string name="sheet_fototipo_desc_3">Às vezes queima, bronzeia aos poucos</string>
    <string name="sheet_fototipo_desc_4">Raramente queima, bronzeia bem</string>
    <string name="sheet_fototipo_desc_5">Quase nunca queima, bronzeia bastante</string>
    <string name="sheet_fototipo_desc_6">Nunca queima, bronzeia sempre</string>

    <string name="sheet_sens_titulo">Qual é a sensibilidade da sua pele?</string>
    <string name="sheet_sens_descricao">Sensibilidade não é o mesmo que tipo de pele. Aqui a pergunta é o quanto ela se irrita com produto novo, perfume, sol ou calor.</string>
    <string name="sheet_sens_desc_baixa">Tolera quase tudo. Raramente arde, coça ou fica vermelha quando você testa um produto novo.</string>
    <string name="sheet_sens_desc_media">Reage de vez em quando. Ácido, perfume, sol ou calor podem causar ardência ou vermelhidão leve, que passa rápido.</string>
    <string name="sheet_sens_desc_alta">Reage com facilidade. Ardência, coceira, vermelhidão ou descamação aparecem com frequência, até com produtos suaves.</string>

