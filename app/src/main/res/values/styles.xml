<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CardVenus">
        <item name="android:background">@drawable/bg_card_branco</item>
        <item name="android:paddingStart">@dimen/card_padding_lateral</item>
        <item name="android:paddingEnd">@dimen/card_padding_lateral</item>
    </style>

    <style name="CampoVenus">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/altura_campo</item>
        <item name="android:background">@drawable/bg_input_borda</item>
        <item name="android:paddingStart">@dimen/padding_interno_campo</item>
        <item name="android:paddingEnd">@dimen/padding_interno_campo</item>
        <item name="android:textColor">@color/preto_texto</item>
        <item name="android:textColorHint">@color/cinza_hint</item>
        <item name="android:textSize">@dimen/texto_campo</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="LabelCampo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto_label</item>
        <item name="android:textSize">@dimen/texto_label</item>
    </style>

    <style name="TextoAjuda">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto_ajuda</item>
        <item name="android:textSize">@dimen/texto_ajuda</item>
    </style>

    <style name="BotaoGoogle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/altura_campo</item>
        <item name="android:background">@drawable/bg_input_borda</item>
        <item name="android:scaleType">center</item>
        <item name="android:src">@drawable/ic_google</item>
    </style>

    <style name="EscolhaModalChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_fundo_escolha</item>
        <item name="chipStrokeColor">@color/chip_borda_escolha</item>
        <item name="chipStrokeWidth">1.2dp</item>
        <item name="android:textColor">@color/chip_texto_escolha</item>
        <item name="android:textSize">13sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="rippleColor">@color/chip_fundo_escolha</item>
    </style>

    <!-- Chip das categorias da Busca: fundo lilas cheio em vez de branco com
         borda, para nao parecer apagado; selecionado vira roxo solido, para o
         filtro ativo ficar obvio. -->
    <style name="CategoriaBuscaChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_categoria_fundo</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">@color/chip_categoria_texto</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">38dp</item>
        <item name="chipStartPadding">14dp</item>
        <item name="chipEndPadding">14dp</item>
    </style>

    <style name="BotaoGradiente">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/altura_campo</item>
        <item name="android:background">@drawable/bg_botao_gradiente</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/texto_botao</item>
    </style>

    <style name="BotaoBranco" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/altura_campo</item>
        <item name="android:textColor">@color/roxo_venus</item>
        <item name="backgroundTint">@color/white</item>
        <item name="cornerRadius">@dimen/raio_pilula</item>
    </style>

    <style name="BotaoContorno" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/altura_campo</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/raio_pilula</item>
        <item name="strokeColor">@color/white</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="TituloCard">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/preto_texto</item>
        <item name="android:textSize">@dimen/texto_titulo_card</item>
    </style>

    <style name="LinkVenus">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">4dp</item>
        <item name="android:textColor">@color/roxo_link</item>
        <item name="android:textSize">@dimen/texto_link</item>
    </style>

    <style name="BotaoAvancar">
        <item name="android:layout_width">@dimen/botao_circular</item>
        <item name="android:layout_height">@dimen/botao_circular</item>
        <item name="android:background">@drawable/bg_botao_circular</item>
        <item name="android:scaleType">center</item>
        <item name="android:src">@drawable/ic_seta_avancar</item>
    </style>

    <style name="OpcaoPergunta">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/altura_opcao</item>
        <item name="android:background">@drawable/bg_opcao</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/preto_texto</item>
        <item name="android:textSize">@dimen/texto_campo</item>
    </style>

    <style name="LinkClaro">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">4dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/texto_corpo</item>
    </style>

    <style name="FioTipoCabelo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/altura_fio</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="SecaoTipoCabelo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/espaco_medio</item>
        <item name="android:layout_marginBottom">@dimen/espaco_pequeno</item>
        <item name="android:textColor">@color/roxo_secao</item>
        <item name="android:textSize">@dimen/texto_corpo</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CardTipoCabelo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/espaco_pequeno</item>
        <item name="android:background">@drawable/bg_item_tipo</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/espaco_medio</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">@dimen/espaco_medio</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="TituloTipoCabelo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/preto_texto</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DescricaoTipoCabelo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/cinza_descricao</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="BotaoVoltar">
        <item name="android:layout_width">@dimen/area_toque_minima</item>
        <item name="android:layout_height">@dimen/area_toque_minima</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="android:src">@drawable/ic_seta_voltar</item>
    </style>

    <style name="FotoProdutoArredondada">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="CapaListaTopo">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">14dp</item>
        <item name="cornerSizeTopRight">14dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="FotoHistoricoArredondada">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="AvatarRedondo">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TituloSecaoPerfil">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/espaco_grande</item>
        <item name="android:textColor">@color/preto_texto</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SubtituloSecaoPerfil">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/roxo_marca</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CampoBuscaPerfil">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/altura_opcao</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/bg_busca_topo</item>
        <item name="android:drawableStart">@drawable/ic_lupa</item>
        <item name="android:drawablePadding">@dimen/espaco_pequeno</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">@dimen/espaco_medio</item>
        <item name="android:paddingEnd">@dimen/espaco_medio</item>
        <item name="android:textColor">@color/preto_texto</item>
        <item name="android:textColorHint">@color/cinza_hint</item>
        <item name="android:textSize">@dimen/texto_corpo</item>
    </style>

</resources>
