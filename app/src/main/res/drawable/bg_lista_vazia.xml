<?xml version="1.0" encoding="utf-8"?>
<!-- Caixa de "lista vazia". O tracejado precisa de <stroke dashWidth/dashGap>;
     um shape com solid nao consegue desenhar borda pontilhada. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="@color/borda_tracejada"
        android:dashGap="5dp"
        android:dashWidth="7dp" />
    <corners android:radius="12dp" />
</shape>
