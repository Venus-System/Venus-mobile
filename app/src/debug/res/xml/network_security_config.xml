<?xml version="1.0" encoding="utf-8"?>
<!-- Substitui o src/main/res/xml/network_security_config.xml no build de debug,
     por isso repete o IP da Venus-AI-api na AWS. O resto e para testar a API de
     IA rodando no PC antes de ela estar publicada: no celular com
     "adb reverse tcp:8080 tcp:8080" o endereco e localhost, e no emulador o PC
     aparece como 10.0.2.2. Fora desses enderecos continua valendo o padrao do
     Android (so HTTPS). Este arquivo nao existe no build de release. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">44.222.132.139</domain>
    </domain-config>
</network-security-config>
